{
  "name": "doctor-consult",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "node --loader ts-node/esm --watch src/main.ts",
    "start": "npm run build && node dist/main.js",
    "start:dev": "tsc-watch --onSuccess \"node dist/main.js\""
  },
  "dependencies": {
    "@fastify/autoload": "^6.3.1",
    "fastify": "^5.7.2",
    "fastify-plugin": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "tsc-watch": "^7.2.0",
    "typescript": "^5.0.0"
  }
}
