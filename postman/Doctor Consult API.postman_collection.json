{
	"info": {
		"_postman_id": "doctor-consult-api",
		"name": "Doctor Consult API",
		"description": "Telemedicine platform API for booking consultations and managing prescriptions",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/health",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"health"
					]
				}
			},
			"response": []
		},
		{
			"name": "Doctors",
			"item": [
				{
					"name": "Get All Doctors",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/doctors",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"doctors"
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Doctors by Specialty",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/doctors?specialty=cardiology",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"doctors"
							],
							"query": [
								{
									"key": "specialty",
									"value": "cardiology"
								}
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Appointments",
			"item": [
				{
					"name": "Create Appointment",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"patientId\": \"{{patientId}}\",\n  \"doctorId\": \"{{doctorId}}\",\n  \"startTime\": \"2024-12-15T10:00:00Z\",\n  \"endTime\": \"2024-12-15T11:00:00Z\",\n  \"notes\": \"Regular checkup\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/appointments",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"appointments"
							]
						}
					},
					"response": []
				},
				{
					"name": "Complete Appointment",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"notes\": \"Patient examined successfully, vitals normal\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/appointments/{{appointmentId}}/complete",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"appointments",
								"{{appointmentId}}",
								"complete"
							]
						}
					},
					"response": []
				},
				{
					"name": "Create Prescription",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"diagnosis\": \"Hypertension Stage 1\",\n  \"instructions\": \"Take medication as prescribed, monitor blood pressure daily, follow up in 2 weeks\",\n  \"medications\": [\n    {\n      \"name\": \"Lisinopril\",\n      \"dosage\": \"10mg\",\n      \"frequency\": \"Once daily\",\n      \"duration\": \"30 days\",\n      \"notes\": \"Take in the morning with water\"\n    },\n    {\n      \"name\": \"Hydrochlorothiazide\",\n      \"dosage\": \"25mg\",\n      \"frequency\": \"Once daily\",\n      \"duration\": \"30 days\",\n      \"notes\": \"Take with food to avoid stomach upset\"\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/appointments/{{appointmentId}}/prescription",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"appointments",
								"{{appointmentId}}",
								"prescription"
							]
						}
					},
					"response": []
				}
			]
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000",
			"type": "string"
		},
		{
			"key": "patientId",
			"value": "patient_user_id_here",
			"type": "string"
		},
		{
			"key": "doctorId",
			"value": "doctor_user_id_here",
			"type": "string"
		},
		{
			"key": "appointmentId",
			"value": "appointment_id_here",
			"type": "string"
		}
	]
}
